        "def print_board(board):\n",
        "  for row in board:\n",
        "    print(\" \".join(row))\n",
        "\n",
        "def is_safe(board,row,col):\n",
        "  # Check for queens in the same column (above the current row)\n",
        "  for i in range(row):\n",
        "    if board[i][col]=='Q': # Corrected from board[i][row] to board[i][col]\n",
        "      return False\n",
        "\n",
        "  # Check upper left diagonal\n",
        "  i=row-1\n",
        "  j=col-1\n",
        "  while i>=0 and j>=0:\n",
        "    if board[i][j]=='Q':\n",
        "      return False\n",
        "    i-=1\n",
        "    j-=1\n",
        "\n",
        "  # Check upper right diagonal\n",
        "  i=row-1\n",
        "  j=col+1\n",
        "  while i>=0 and j<8:\n",
        "    if board[i][j]=='Q':\n",
        "      return False\n",
        "    i-=1\n",
        "    j+=1\n",
        "  return True # This return needs to be specific to the is_safe function\n",
        "\n",
        "#backtracking the function\n",
        "def solve_n_queens(board,row):\n",
        "  if row==8:\n",
        "    return True\n",
        "  for col in range(8):\n",
        "    if is_safe(board,row,col):\n",
        "      board[row][col]='Q'\n",
        "      if solve_n_queens(board,row+1):\n",
        "        return True\n",
        "      board[row][col]='.'\n",
        "  return False\n",
        "# main program\n",
        "board=[['.' for _ in range(8)] for _ in range(8)]\n",
        "\n",
        "if solve_n_queens(board,0): # Corrected 'solve' to 'solve_n_queens'\n",
        "  print_board(board)\n",
        "else:\n",
        "  print(\"No solution exists\")"
      ]
