        "#minmax algorithm\n",
        "def minmax(depth,nodeIndex,isMax,scores,height):\n",
        "  #base case: left node reach\n",
        "  if depth==height:\n",
        "    return scores[nodeIndex]\n",
        "\n",
        "  if isMax:\n",
        "    return max(minmax(depth+1,nodeIndex*2,False,scores,height),minmax(depth+1,nodeIndex*2+1,False,scores,height))\n",
        "  else:\n",
        "    return min(minmax(depth+1,nodeIndex*2,True,scores,height),minmax(depth+1,nodeIndex*2+1,True,scores,height))\n",
        "\n",
        "#main program\n",
        "scores= list(map(int,input(\"Enter 8 leaf node value\").split()))\n",
        "height=3\n",
        "result=minmax(0,0,True,scores,height)\n",
        "print(\"The optimal value is\",result)"
