        "def print_board(board):\n",
        "  for row in board:\n",
        "    print(\" | \".join(row))\n",
        "    print(\"-\"*9)\n",
        "\n",
        "def check_winner(board):\n",
        "  for row in board:\n",
        "    if row[0]==row[1]==row[2]!=\" \":\n",
        "      return True\n",
        "\n",
        "  for col in range(3):\n",
        "    if board[0][col]== board[1][col]== board[2][col]!=\" \":\n",
        "      return True\n",
        "  if board[0][0]== board[1][1]== board[2][2]!=\" \":\n",
        "    return True\n",
        "  if board[0][2]== board[1][1]== board[2][0]!=\" \":\n",
        "    return True\n",
        "  return False\n",
        "\n",
